  <Target Name="EnsureNoRunningApp" BeforeTargets="Build;Clean">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command ^&#xD;&#xA;        $exe='$(TargetFileName)'; ^&#xD;&#xA;        $name=[System.IO.Path]::GetFileNameWithoutExtension($exe); ^&#xD;&#xA;        $killed=$false; ^&#xD;&#xA;        Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.Name -eq $name } | ForEach-Object { try { $_ | Stop-Process -Force -PassThru | Out-Null; $killed=$true } catch {} }; ^&#xD;&#xA;        if($killed){ Start-Sleep -Milliseconds 400 }; ^&#xD;&#xA;        $deadline=[DateTime]::Now.AddSeconds(6); ^&#xD;&#xA;        while([DateTime]::Now -lt $deadline){ ^&#xD;&#xA;          $alive=Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.Name -eq $name }; ^&#xD;&#xA;          if(-not $alive){ break }; ^&#xD;&#xA;          Start-Sleep -Milliseconds 200 ^&#xD;&#xA;        }" ContinueOnError="true" />
  </Target>

