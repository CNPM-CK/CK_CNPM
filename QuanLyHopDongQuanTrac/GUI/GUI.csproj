<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <Target Name="EnsureNoRunningApp" BeforeTargets="Build;Clean">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command ^&#xD;&#xA;        $exe='$(TargetFileName)'; ^&#xD;&#xA;        $name=[System.IO.Path]::GetFileNameWithoutExtension($exe); ^&#xD;&#xA;        $killed=$false; ^&#xD;&#xA;        Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.Name -eq $name } | ForEach-Object { try { $_ | Stop-Process -Force -PassThru | Out-Null; $killed=$true } catch {} }; ^&#xD;&#xA;        if($killed){ Start-Sleep -Milliseconds 400 }; ^&#xD;&#xA;        $deadline=[DateTime]::Now.AddSeconds(6); ^&#xD;&#xA;        while([DateTime]::Now -lt $deadline){ ^&#xD;&#xA;          $alive=Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.Name -eq $name }; ^&#xD;&#xA;          if(-not $alive){ break }; ^&#xD;&#xA;          Start-Sleep -Milliseconds 200 ^&#xD;&#xA;        }" ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <None Remove="Report\ChiTietKetQua.rdlc" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Report\ChiTietKetQua.rdlc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.9" />
    <PackageReference Include="ReportViewerCore.NETCore" Version="15.1.26" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BLL\BLL.csproj" />
    <ProjectReference Include="..\DTO\DTO.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\Logo\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Forms\DanhSachHD.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\ThemHopDong.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
