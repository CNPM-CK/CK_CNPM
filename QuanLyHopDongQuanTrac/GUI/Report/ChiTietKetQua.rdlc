										<Value>="Ngày tạo: " &amp; Format(First(Fields!NgayTao.Value, "dsHeader"), "dd/MM/yyyy") &amp; "  |  Ngày trả KQ: " &amp; IIF(IsNothing(First(Fields!NgayTraKQ.Value, "dsHeader")), "Chưa có", Format(First(Fields!NgayTraKQ.Value, "dsHeader"), "dd/MM/yyyy")) &amp; "  |  Người lập: " &amp; First(Fields!TenNhanVien.Value, "dsHeader") &amp; "  |  Trạng thái: " &amp; First(Fields!TrangThai.Value, "dsHeader")</Value>
